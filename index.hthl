<!DOCTYPE html>
<html>
<head>
<title>Car Racing Game</title>
<style>
  body { margin: 0; overflow: hidden; background: #222; font-family: 'Courier New', monospace; }
  #gameContainer { position: relative; width: 400px; margin: 20px auto; }
  #gameCanvas { display: block; background: #666; border: 5px solid #fff; box-shadow: 0 0 20px rgba(0,0,0,0.5); }
  #restartBtn {
    display: none;
    position: absolute;
    top: 55%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 15px 30px;
    font-size: 22px;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    background-color: #ff3333;
    color: white;
    border: 2px solid white;
    cursor: pointer;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
  }
  #restartBtn:hover { background-color: #cc0000; transform: translate(-50%, -52%); }
</style>
</head>
<body>
<div id="gameContainer">
  <canvas id="gameCanvas" width="400" height="600"></canvas>
  <button id="restartBtn" onclick="resetGame()">PLAY AGAIN</button>
</div>
<script>
  const canvas = document.getElementById("gameCanvas");
  const ctx = canvas.getContext("2d");
  const restartBtn = document.getElementById("restartBtn");

  // Image URLs for vehicles
  const playerCarImg = new Image();
  playerCarImg.src = 'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?w=150&auto=format&fit=crop&q=80'; // Sports Car

  const vehicleImages = [
    new Image(), // Normal Car 1
    new Image(), // Normal Car 2
    new Image(), // Truck
    new Image()  // Bus
  ];
  vehicleImages[0].src = 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=150&auto=format&fit=crop&q=80';
  vehicleImages[1].src = 'https://images.unsplash.com/photo-1494976388531-d1058494cdd8?w=150&auto=format&fit=crop&q=80';
  vehicleImages[2].src = 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?w=150&auto=format&fit=crop&q=80';
  vehicleImages[3].src = 'https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=150&auto=format&fit=crop&q=80';

  let carX, carY, carNodes;
  let obstacleX, obstacleY, obstacleNodes, currentObstacleImg;
  let score, highScore, gameOver;
  let rightPressed, leftPressed;

  function initGame() {
    carX = 165;
    carY = 480;
    carWidth = 70;
    carHeight = 110;
    carSpeed = 7;
    
    spawnObstacle();
    
    score = 0;
    highScore = localStorage.getItem("highScore") || 0;
    gameOver = false;
    rightPressed = false;
    leftPressed = false;
    
    restartBtn.style.display = "none";
  }

  function spawnObstacle() {
    const obstacleTypes = [
      { w: 60, h: 100, speed: 5 }, // Normal Car
      { w: 60, h: 100, speed: 5 }, // Normal Car
      { w: 70, h: 140, speed: 3.5 }, // Truck
      { w: 70, h: 150, speed: 3 }   // Bus
    ];
    const randomIndex = Math.floor(Math.random() * obstacleTypes.length);
    currentObstacleImg = vehicleImages[randomIndex];
    currentObstacleType = obstacleTypes[randomIndex];

    obstacleX = Math.floor(Math.random() * (400 - currentObstacleType.w));
    obstacleY = -150;
    obstacleWidth = currentObstacleType.w;
    obstacleHeight = currentObstacleType.h;
    obstacleSpeed = currentObstacleType.speed;
  }

  document.addEventListener("keydown", keyDownHandler);
  document.addEventListener("keyup", keyUpHandler);

  function keyDownHandler(e) {
    if(e.key === "Right" || e.key === "ArrowRight") rightPressed = true;
    else if(e.key === "Left" || e.key === "ArrowLeft") leftPressed = true;
  }

  function keyUpHandler(e) {
    if(e.key === "Right" || e.key === "ArrowRight") rightPressed = false;
    else if(e.key === "Left" || e.key === "ArrowLeft") leftPressed = false;
  }

  function drawRoad() {
    ctx.beginPath();
    ctx.fillStyle = "#333";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    ctx.strokeStyle = "#555";
    ctx.lineWidth = 10;
    ctx.strokeRect(5, 5, canvas.width - 10, canvas.height - 10);

    ctx.beginPath();
    ctx.setLineDash([30, 30]);
    ctx.moveTo(200, 0);
    ctx.lineTo(200, 600);
    ctx.strokeStyle = "yellow";
    ctx.lineWidth = 8;
    ctx.stroke();
  }

  function collisionDetection() {
    if (carX < obstacleX + obstacleWidth &&
        carX + carWidth > obstacleX &&
        carY < obstacleY + obstacleHeight &&
        carY + carHeight > obstacleY) {
      gameOver = true;
      if (score > highScore) {
        highScore = score;
        localStorage.setItem("highScore", highScore);
      }
      restartBtn.style.display = "block";
    }
  }

  function resetGame() {
    initGame();
    draw();
  }

  function draw() {
    drawRoad();

    if(gameOver) {
      ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      ctx.fillStyle = "#ff3333";
      ctx.font = "bold 50px 'Courier New', monospace";
      ctx.textAlign = "center";
      ctx.fillText("CRASH!", canvas.width/2, 220);
      
      ctx.fillStyle = "#fff";
      ctx.font = "30px 'Courier New', monospace";
      ctx.fillText("GAME OVER", canvas.width/2, 280);
    } else {
      ctx.drawImage(playerCarImg, carX, carY, carWidth, carHeight);
      ctx.drawImage(currentObstacleImg, obstacleX, obstacleY, obstacleWidth, obstacleHeight);
      
      collisionDetection();

      obstacleY += obstacleSpeed;
      if(obstacleY > canvas.height) {
        spawnObstacle();
        score++;
        obstacleSpeed += 0.1;
      }

      if(rightPressed && carX < canvas.width - carWidth) carX += carSpeed;
      if(leftPressed && carX > 0) carX -= carSpeed;
    }

    ctx.fillStyle = "#fff";
    ctx.font = "20px 'Courier New', monospace";
    ctx.textAlign = "left";
    ctx.fillText("Score: " + score, 20, 40);
    ctx.fillText("High Score: " + highScore, 20, 70);

    if(!gameOver) {
      requestAnimationFrame(draw);
    }
  }

  playerCarImg.onload = () => {
    vehicleImages[0].onload = () => {
      initGame();
      draw();
    };
  };
</script>
</body>
</html>
